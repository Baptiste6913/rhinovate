---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroStage from '../components/HeroStage.astro';
import Workspace from '../components/Workspace.astro';
import DemoForm from '../components/DemoForm.astro';
import Faq from '../components/Faq.astro';

const faq = [
  {
    q: 'What does the clinic need?',
    a: 'An iPhone with Face ID. Its front camera captures the depth data the 3D model is built from.'
  },
  {
    q: 'How long does a scan take?',
    a: 'The patient turns through five head positions and the app captures each one automatically. The 3D model is ready while the patient is still in the room.'
  },
  {
    q: 'Where does the recovery forecast come from?',
    a: "From Rhinovate's healing model, calibrated on published clinical recovery data. It shows a typical course, adjusted to the patient's skin thickness and age. Our goal is a model of our own, trained on 3D follow-up scans from partner clinics."
  },
  {
    q: 'Is the simulation a promise of the result?',
    a: "No. It is a planning and communication aid. The final result depends on the patient's anatomy and on how they heal."
  },
  {
    q: 'How do we get started?',
    a: 'Request a demo. We set up your clinic and walk your team through a first case.'
  }
];

const compareRows = [
  { label: 'Planned nose', photo: 'One angle per photo', sim: "Every angle, on the patient's face", us: "Every angle, on the patient's face" },
  { label: 'Capture', photo: 'Photos', sim: 'Dedicated 3D camera or a set of photos', us: 'An iPhone with Face ID' },
  { label: 'Recovery forecast', photo: null, sim: null, us: 'From the first days to month 12' },
  { label: 'Forecast adjusted to the patient', photo: null, sim: null, us: 'Skin thickness and age' }
];
---
<BaseLayout preloadFace stage>
  <HeroStage />

  <section class="section" id="try" aria-labelledby="try-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="try-title">Try the consultation on a demo face</h2>
        <p>Change the hump and the tip, then open the recovery forecast for the same plan.</p>
      </div>
      <Workspace id="try-ws" />
    </div>
  </section>

  <section class="section" id="gap" aria-labelledby="gap-title">
    <div class="wrap split">
      <div class="sec-head">
        <h2 id="gap-title">Patients judge the result twice.</h2>
        <p>Rhinovate gives you and your patient the same picture of both moments.</p>
      </div>
      <div class="split-cols">
        <article class="rule-top">
          <h3>In the consultation</h3>
          <p>A retouched photo shows one angle and can promise more than surgery delivers. On a 3D model of their own face, your patient sees the plan from every angle, next to their nose today.</p>
          <a class="text-link" href="/how-it-works">How planning works</a>
        </article>
        <article class="rule-top">
          <h3>During the recovery</h3>
          <p>Swelling hides the result for weeks and stays at the tip for months. A patient who has seen the forecast knows what normal looks like at each stage.</p>
          <a class="text-link" href="/healing">See the recovery forecast</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="compare" aria-labelledby="compare-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="compare-title">More than a simulation of the result</h2>
        <p>Simulation tools stop at the final nose. Rhinovate also forecasts the recovery that leads to it.</p>
      </div>
      <table class="compare">
        <caption class="sr-only">Rhinovate compared with 2D photo morphing and 3D simulation tools</caption>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Feature</span></th>
            <th scope="col">2D photo morphing</th>
            <th scope="col">3D simulation tools</th>
            <th scope="col" class="is-us">Rhinovate</th>
          </tr>
        </thead>
        <tbody>
          {compareRows.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              <td data-label="2D photo morphing" class:list={[{ no: !r.photo }]}>{r.photo ?? 'Not covered'}</td>
              <td data-label="3D simulation tools" class:list={[{ no: !r.sim }]}>{r.sim ?? 'Not covered'}</td>
              <td data-label="Rhinovate" class="is-us">{r.us}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="small table-note">Based on publicly available product information, October 2026.</p>
    </div>
  </section>

  <section class="section" id="how" aria-labelledby="how-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="how-title">How a consultation runs with Rhinovate</h2>
      </div>
      <ol class="steps">
        <li class="step">
          <p class="kicker">Before the consult</p>
          <h3>Scan</h3>
          <p>The patient turns through five head positions in front of an iPhone. The app captures each angle automatically.</p>
        </li>
        <li class="step">
          <p class="kicker">During the consult</p>
          <h3>Plan</h3>
          <p>You shape the nose on the 3D model with the patient beside you, next to their nose today.</p>
        </li>
        <li class="step">
          <p class="kicker">Same visit</p>
          <h3>Forecast</h3>
          <p>The patient sees how swelling and bruising will evolve on the planned nose, stage by stage.</p>
        </li>
        <li class="step">
          <p class="kicker">Before surgery</p>
          <h3>Decide</h3>
          <p>Your patient commits to a plan they have seen, with a clear picture of the months that follow.</p>
        </li>
      </ol>
      <p class="sec-foot"><a class="text-link" href="/how-it-works">See the full workflow</a></p>
    </div>
  </section>

  <section class="section" id="recovery" aria-labelledby="recovery-title">
    <div class="wrap">
      <div class="recovery-grid">
        <div class="recovery-copy">
          <h2 id="recovery-title">Anticipate the whole recovery, not only the result.</h2>
          <p>The forecast follows the planned nose from the first days to month 12, zone by zone. The tip settles last, and your patient sees it coming.</p>
          <p><a class="text-link" href="/healing">Open the recovery forecast</a></p>
        </div>
        <div class="recovery-media">
          <div class="trio">
            <figure class="shot">
              <img src="/images/heal-day2.webp" width="800" height="1000" alt="Planned nose on day 2, swollen, with bruising around the eyes" loading="lazy" decoding="async" />
              <figcaption>Day 2</figcaption>
            </figure>
            <figure class="shot">
              <img src="/images/heal-month1.webp" width="800" height="1000" alt="Planned nose at month 1, with mild swelling at the tip" loading="lazy" decoding="async" />
              <figcaption>Month 1</figcaption>
            </figure>
            <figure class="shot">
              <img src="/images/heal-month12.webp" width="800" height="1000" alt="Planned nose at month 12, settled" loading="lazy" decoding="async" />
              <figcaption>Month 12</figcaption>
            </figure>
          </div>
          <p class="small">Forecast on the demo face. Every patient heals differently.</p>
        </div>
      </div>
      <div class="split-cols recovery-basis">
          <article class="rule-top">
            <p class="kicker">Today</p>
            <h3>Built on clinical data</h3>
            <p>The forecast runs on Rhinovate's healing model, calibrated on published clinical recovery data. It adjusts to the patient's skin thickness and age.</p>
          </article>
          <article class="rule-top">
            <p class="kicker">Next</p>
            <h3>Our own AI model</h3>
            <p>Our goal is a model trained on 3D follow-up scans that partner clinics share with their patients' consent, so the forecast learns from real recoveries.</p>
            <a class="text-link" href="/demo#partner">Become a partner clinic</a>
          </article>
      </div>
    </div>
  </section>

  <section class="section" id="practice" aria-labelledby="practice-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="practice-title">What changes in your practice</h2>
      </div>
      <div class="grid-2">
        <article>
          <h3>Consultations that end in a decision</h3>
          <p>Your patient decides on a nose they have already seen on their own face, from every angle.</p>
        </article>
        <article>
          <h3>Expectations set on your plan</h3>
          <p>What your patient expects comes from the plan you made together, not from an edited photo.</p>
        </article>
        <article>
          <h3>Calmer weeks after surgery</h3>
          <p>Your patient has seen each stage of the recovery in advance, including the months when the tip is still settling.</p>
        </article>
        <article>
          <h3>No hardware to buy</h3>
          <p>An iPhone with Face ID is enough. There is no camera rig to install or calibrate.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="company" aria-labelledby="company-title">
    <div class="wrap proof-grid">
      <div>
        <h2 id="company-title">Built with surgeons</h2>
        <p>Rhinovate was developed with input from practicing surgeons and founded in San Francisco by Deesha Pathak and Baptiste Bouault.</p>
        <p><a class="text-link" href="/about">About Rhinovate</a></p>
      </div>
      <dl class="facts">
        <div><dt>113</dt><dd>surgeons interviewed while building the product</dd></div>
        <div><dt>2,500+</dt><dd>people have used the simulation</dd></div>
      </dl>
    </div>
  </section>

  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="faq-title">Questions surgeons ask</h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <section class="section" id="demo" aria-labelledby="demo-title">
    <div class="wrap demo-grid">
      <div class="demo-copy">
        <h2 id="demo-title">See it on a full consultation</h2>
        <p>Tell us about your practice. We'll email you to pick a time and walk you through a sample case, from the scan to the recovery forecast.</p>
      </div>
      <DemoForm id="home-demo" />
    </div>
  </section>
</BaseLayout>
