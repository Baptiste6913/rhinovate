---
import BaseLayout from '../layouts/BaseLayout.astro';
import DemoForm from '../components/DemoForm.astro';
---
<BaseLayout
  title="Request a demo"
  description="See a full Rhinovate consultation on a sample case, from the guided iPhone scan to the recovery forecast."
>
  <section class="page-head" aria-labelledby="page-title">
    <div class="wrap">
      <h1 id="page-title">Request a demo</h1>
      <p class="lead">We walk you through a full consultation on a sample case, from the scan to the recovery forecast.</p>
    </div>
  </section>

  <section class="section demo-page" aria-labelledby="form-title">
    <div class="wrap demo-grid">
      <div class="demo-copy">
        <h2 id="form-title" class="sr-only">Demo request form</h2>
        <h3>What happens next</h3>
        <ol class="seq">
          <li><div><p>We email you to pick a time that suits your clinic.</p></div></li>
          <li><div><p>We go through a sample case together. If Rhinovate fits your practice, we set up your clinic and your team's first case.</p></div></li>
        </ol>
        <h3>What you need</h3>
        <dl class="specs">
          <div><dt>For the scan</dt><dd>An iPhone with Face ID</dd></div>
        </dl>
        <div class="rule-top" id="partner">
          <h3>Partner clinics</h3>
          <p>Our goal is a recovery model of our own, trained on real recoveries. Partner clinics help build it by sharing 3D follow-up scans, with their patients' consent. Tick the box in the form if your clinic is interested.</p>
        </div>
        <p class="small">If you have questions first, see <a class="text-link" href="/#faq">what surgeons usually ask</a>.</p>
      </div>
      <DemoForm id="page-demo" />
    </div>
  </section>
</BaseLayout>
