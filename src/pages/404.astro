---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This page does not exist or has moved.">
  <section class="section" style="border-top: 0">
    <div class="wrap notfound">
      <h1>This page does not exist.</h1>
      <p class="lead">It may have moved. The home page and the demo request are one click away.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn btn-quiet" href="/demo">Request a demo</a>
      </div>
    </div>
  </section>
</BaseLayout>
